# Copia este archivo como .env y rellena los valores de https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Intervals.icu: https://intervals.icu/settings > Developer Settings
INTERVALS_API_KEY=

# Asistente IA (API compatible con OpenAI). Clave de Gemini: https://aistudio.google.com/apikey
AI_API_KEY=

# Opcionales
INTERVALS_ATHLETE_ID=0
PORT=3001
APP_URL=http://localhost:5173
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.7-flash
# Modelos de respaldo, en orden, si el principal está saturado
AI_FALLBACK_MODELS=gemini-3.6-flash
# "none", "low", "medium" o "high"; vacío para no enviarlo
AI_REASONING_EFFORT=low
AI_MAX_REQUESTS_PER_MINUTE=8
AI_MAX_REQUESTS_PER_DAY=200
